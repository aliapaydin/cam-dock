{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cam Dock",
  "version": "0.6.0",
  "identifier": "com.ali.camdock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Ali Apaydın",
    "copyright": "© 2026 Ali Apaydın",
    "shortDescription": "Windows 11 için cam dock"
  }
}
